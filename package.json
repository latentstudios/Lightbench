{
  "name": "lightbench",
  "productName": "Lightbench",
  "version": "1.1.0",
  "description": "Lightbench — photo library, RAW editor and AI masking for Windows and macOS",
  "main": "desktop.js",
  "private": true,
  "author": "Latent Studios",
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.latentstudios.lightbench",
    "productName": "Lightbench",
    "copyright": "Copyright © 2026 Latent Studios",
    "files": ["desktop.js", "server.js", "app/**/*", "build/icon.png", "package.json", "LICENSE.txt"],
    "extraResources": [{ "from": "LICENSE.txt", "to": "legal/LICENSE.txt" }, { "from": "app/legal", "to": "legal" }],
    "directories": { "output": "dist", "buildResources": "build" },
    "publish": { "provider": "github", "owner": "latentstudios", "repo": "lightbench", "releaseType": "release" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Lightbench-Setup-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lightbench",
      "uninstallDisplayName": "Lightbench",
      "license": "LICENSE.txt",
      "runAfterFinish": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.photography",
      "artifactName": "Lightbench-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Lightbench",
      "artifactName": "Lightbench-mac-${arch}.${ext}"
    }
  }
}
